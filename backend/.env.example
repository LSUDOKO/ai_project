# Postgres connection string (Neon pooled URL in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rollcall
# Long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Comma-separated list of sites allowed to call the API
FRONTEND_ORIGIN=http://localhost:3000
# Cosine similarity needed to count two faces as the same person
FACE_MATCH_THRESHOLD=0.42
